{
	"name": "n8n-nodes-antwork",
	"version": "0.1.0",
	"description": "n8n nodes for Antwork: draft, schedule and publish social posts to LinkedIn, Instagram, X, TikTok, YouTube, Threads and more.",
	"license": "MIT",
	"homepage": "https://antwork.io/?utm_source=n8n&utm_medium=referral&utm_campaign=directories",
	"keywords": [
		"n8n-community-node-package",
		"antwork",
		"social media",
		"scheduler",
		"linkedin",
		"instagram"
	],
	"author": {
		"name": "Antwork",
		"email": "iker.gonzalez@antwork.io"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/polynode-co/n8n-nodes-antwork.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/AntworkApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Antwork/Antwork.node.js",
			"dist/nodes/Antwork/AntworkTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"eslint": "9.39.4",
		"prettier": "3.8.3",
		"release-it": "20.2.0",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
